# Server
PORT=8888
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (local dev via Docker)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=managework

# Redis (enabled for dev, Docker on localhost)
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=7d

